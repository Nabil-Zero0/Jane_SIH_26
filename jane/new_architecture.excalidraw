    {
      "id": "zkgNc_YCoC0Uxw1LDuTlZ",
      "type": "text",
      "x": 618,
      "y": 156,
      "width": 484,
      "height": 192,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFp",
      "roundness": null,
      "seed": 757800915,
      "version": 269,
      "versionNonce": 1919769475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790067729458,
      "created": 1790010434188,
      "link": null,
      "locked": false,
      "text": "Then as soon as the user hits Enter, we create an opencode session or we\ncreate a folder for that job because we need to keep the things organized. In\nit there is some kind of metadata JSON for opencode, including the\ntimestamps when this opencode session was started or this user entered\nthe query, the opencode session URL, and other metadata. This folder will\ncontain many subfolders as well as more JSON files, such as the output of\neach engine. I have not thought clearly about it but we will create a pretty\norganized folder which will include multiple folders for different engines.\nEach individual output, like the HTML of each onion URL, will be stored in a\nparticular folder maybe or maybe a folder named HTML can have all the\nHTML files. The output of each engine will be stored here. All the\ninformation must be stored somewhere in this folder, properly organized,\nand this will be a format followed for all the other newly created jobs, so a\nformat will be followed for the folder structure for each new job. ",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "08hUphsH9ailwwx6QhXKP",
      "originalText": "Then as soon as the user hits Enter, we create an opencode session or we create a folder for that job because we need to keep the things organized. In it there is some kind of metadata JSON for opencode, including the timestamps when this opencode session was started or this user entered the query, the opencode session URL, and other metadata. This folder will contain many subfolders as well as more JSON files, such as the output of each engine. I have not thought clearly about it but we will create a pretty organized folder which will include multiple folders for different engines. Each individual output, like the HTML of each onion URL, will be stored in a particular folder maybe or maybe a folder named HTML can have all the HTML files. The output of each engine will be stored here. All the information must be stored somewhere in this folder, properly organized, and this will be a format followed for all the other newly created jobs, so a format will be followed for the folder structure for each new job. ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
