    {
      "id": "jewqB-oUmWaaUoon4ciBo",
      "type": "text",
      "x": 4218,
      "y": 156,
      "width": 584,
      "height": 302,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
