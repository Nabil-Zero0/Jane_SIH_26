    {
      "id": "EqLCUOCERrPwGMCL3fgHx",
      "type": "text",
      "x": 1218,
      "y": 156,
      "width": 484,
      "height": 192,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
